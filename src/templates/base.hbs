<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{course.title}} — {{course.code}}</title>
  <meta name="description" content="{{course.title}}, {{course.department}}, {{course.university}}.">
  <link rel="canonical" href="{{course.canonical}}">
  <link rel="stylesheet" href="{{url 'assets/css/main.css'}}">
  <link rel="icon" href="{{url 'favicon.ico'}}" type="image/vnd.microsoft.icon">
</head>
<body>
  <a class="skip-link" href="#home">Skip to content</a>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#home">
        <span class="brand-course">{{course.short_name}}</span>
        <span class="brand-dept">{{course.university}}</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#resources">Resources</a>
        <a href="#lectures">Lectures</a>
        <a href="#assignments">Assignments</a>
        <a href="#project">Project</a>
        <a href="#people">People</a>
      </nav>
    </div>
    {{#if withSolutions}}
    <div class="keys-banner">Instructor build — contains solutions. Do not publish.</div>
    {{/if}}
  </header>

  <main>
    {{{body}}}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div>
        <p class="footer-course">{{course.title}}</p>
        <p class="footer-meta">{{course.code}}</p>
      </div>
      <div>
        <p class="footer-meta">{{course.department}}</p>
        <p class="footer-meta">{{course.college}}, <a href="{{course.university_url}}">{{course.university}}</a></p>
      </div>
    </div>
  </footer>
</body>
</html>
